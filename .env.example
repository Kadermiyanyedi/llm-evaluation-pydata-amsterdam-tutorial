# Copy this file to .env and replace the placeholders. Do not commit .env.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_COMPARISON_MODEL=google/gemini-2.5-flash
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Langfuse Cloud. Create a free project, then copy both keys from
# Project Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# EU region. Use https://us.cloud.langfuse.com for the US region.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

LANGFUSE_PROMPT=pydata-conference-assistant
# Which prompt label the application pulls. Usually production or development.
LANGFUSE_PROMPT_LABEL=development

# End-to-end customer-support tutorial.
LANGFUSE_CUSTOMER_SUPPORT_PROMPT=pydata-customer-support
LANGFUSE_BASELINE_LABEL=baseline
LANGFUSE_CANDIDATE_LABEL=candidate
LANGFUSE_GROUNDEDNESS_PROMPT=pydata-customer-support-groundedness

# Local Qdrant service started with: docker compose up -d
QDRANT_URL=http://localhost:6333

# Cost estimate for the default OpenAI GPT-4.1 mini model, per 1M tokens.
# Update these values when you change the model or provider.
WORKSHOP_INPUT_PRICE_PER_MILLION_USD=0.40
WORKSHOP_OUTPUT_PRICE_PER_MILLION_USD=1.60
