# Copy this file to .env and replace the placeholders. Do not commit .env.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_COMPARISON_MODEL=google/gemini-2.5-flash

# Langfuse Cloud. Create a free project, then copy both keys from
# Project Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# EU region. Use https://us.cloud.langfuse.com for the US region.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

LANGFUSE_PROMPT=pydata-conference-assistant
# Which prompt label the application pulls. Usually production or development.
LANGFUSE_PROMPT_LABEL=development
